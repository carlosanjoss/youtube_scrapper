# Uma chave de API (projetos com uma só chave)
YOUTUBE_API_KEY=

# Múltiplas chaves separadas por vírgula (o scraper alterna automaticamente quando uma esgota)
YOUTUBE_API_KEYS=

# Intervalo entre requisições individuais (segundos) — evita rate limit
REQUEST_SLEEP_SECONDS=1

# Intervalo entre ciclos completos de coleta (segundos) — padrão: 30 minutos
LOOP_INTERVAL_SECONDS=1800
